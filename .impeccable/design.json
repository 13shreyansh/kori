  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action per view in the app; white label on Action Green.",
      "html": "<button class=\"ds-btn-primary\">Move €140 from savings</button>",
      "css": ".ds-btn-primary{font-family:\"Figtree Variable\",system-ui,sans-serif;min-height:48px;padding:10px 24px;border:0;border-radius:999px;background:#007a3d;color:#fff;font-size:16px;font-weight:600;line-height:24px;cursor:pointer;transition:background 120ms;}.ds-btn-primary:hover,.ds-btn-primary:active{background:#00652f;}.ds-btn-primary:focus-visible{outline:2px solid #007a3d;outline-offset:2px;}.ds-btn-primary:disabled{background:#edf2ec;color:#5f7067;}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Secondary action, e.g. \"Add to my Kori\".",
      "html": "<button class=\"ds-btn-quiet\">Add to my Kori</button>",
      "css": ".ds-btn-quiet{font-family:\"Figtree Variable\",system-ui,sans-serif;min-height:48px;padding:10px 24px;border:1px solid #dde5de;border-radius:999px;background:#fff;color:#10241b;font-size:16px;font-weight:600;line-height:24px;cursor:pointer;transition:background 120ms;}.ds-btn-quiet:hover,.ds-btn-quiet:active{background:#edf2ec;}.ds-btn-quiet:focus-visible{outline:2px solid #007a3d;outline-offset:2px;}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Toggle chip; selected takes Green Tint.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\">€600</button><button class=\"ds-chip ds-chip-on\" aria-pressed=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6 9 17l-5-5\"/></svg>€900</button></div>",
      "css": ".ds-chips{display:flex;gap:8px;}.ds-chip{font-family:\"Figtree Variable\",system-ui,sans-serif;display:inline-flex;align-items:center;gap:4px;min-height:36px;padding:7px 12px;border:1px solid #dde5de;border-radius:999px;background:#fff;color:#10241b;font-size:14px;font-weight:600;line-height:20px;cursor:pointer;transition:background 200ms,border-color 200ms;}.ds-chip:hover{background:#edf2ec;}.ds-chip:focus-visible{outline:2px solid #007a3d;outline-offset:2px;}.ds-chip-on,.ds-chip-on:hover{background:#e6f4ea;border-color:#007a3d;color:#007a3d;}"
    },
    {
      "name": "Ask Kori Field",
      "kind": "input",
      "refersTo": "ask-field",
      "description": "The single question field above the tab bar.",
      "html": "<label class=\"ds-ask\"><input placeholder=\"Ask Kori about your money\"><button aria-label=\"Send\" class=\"ds-ask-send\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"m5 12 7-7 7 7M12 19V5\"/></svg></button></label>",
      "css": ".ds-ask{display:flex;align-items:center;height:48px;width:340px;padding:6px 6px 6px 16px;border-radius:999px;background:#edf2ec;}.ds-ask input{font-family:\"Figtree Variable\",system-ui,sans-serif;flex:1;border:0;background:none;font-size:16px;color:#10241b;caret-color:#007a3d;outline:0;}.ds-ask input::placeholder{color:#5f7067;}.ds-ask:focus-within{outline:2px solid #007a3d;outline-offset:2px;}.ds-ask-send{width:36px;height:36px;border:0;border-radius:99px;background:#007a3d;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;}.ds-ask-send:hover{background:#00652f;}"
    },
    {
      "name": "Tab Bar",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Five-tab S-mobiili bar; Kori in the centre.",
      "html": "<nav class=\"ds-tabs\"><button><span><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 10.5 12 3l9 7.5V21H3z\"/></svg></span><small>Home</small></button><button aria-current=\"page\"><span><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 10h18l-2 10H5zM8 10l3-6M16 10l-3-6\"/></svg></span><small>Kori</small></button><button><span><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 21h18M5 10v8M10 10v8M14 10v8M19 10v8M3 10l9-6 9 6z\"/></svg></span><small>Bank</small></button></nav>",
      "css": ".ds-tabs{font-family:\"Figtree Variable\",system-ui,sans-serif;display:flex;width:390px;height:62px;padding:4px 0 3px;background:#fff;border-top:1px solid #e8eee9;}.ds-tabs button{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;border:0;background:none;color:#4a5d53;cursor:pointer;}.ds-tabs button span{width:56px;height:32px;border-radius:999px;display:flex;align-items:center;justify-content:center;transition:background 200ms;}.ds-tabs button:hover span{background:#edf2ec;}.ds-tabs small{font-size:12px;line-height:16px;font-weight:500;}.ds-tabs [aria-current=page]{color:#007a3d;}.ds-tabs [aria-current=page] span{background:#e6f4ea;}.ds-tabs button:focus-visible{outline:2px solid #007a3d;outline-offset:2px;}"
    },
    {
      "name": "Brand Band",
      "kind": "custom",
      "refersTo": "brand-band",
      "description": "Spruce band opening every home: greeting, balance, ruled safe-to-spend row.",
      "html": "<section class=\"ds-band\"><p class=\"ds-band-greet\">Hi Aino. 11 days to payday.</p><p class=\"ds-band-acct\">Käyttötili · FI·· 4471</p><p class=\"ds-band-bal\">€212.35</p><div class=\"ds-band-safe\"><span>Safe to spend</span><b><button class=\"ds-proof-band\">€17</button> a day</b><small>until payday, Thu 26 Nov</small></div></section>",
      "css": ".ds-band{font-family:\"Figtree Variable\",system-ui,sans-serif;width:390px;background:#0e3b2a;color:#fff;border-radius:0 0 28px 28px;padding:2px 20px 16px;font-variant-numeric:tabular-nums lining-nums;}.ds-band p{margin:0;}.ds-band-greet{font-size:15px;line-height:1.4;color:#bfe8cc;}.ds-band-acct{padding-top:6px;font-size:14px;color:rgba(255,255,255,.72);}.ds-band-bal{font-size:38px;line-height:1.1;font-weight:750;letter-spacing:-0.02em;}.ds-band-safe{margin-top:8px;padding-top:10px;border-top:1px solid rgba(255,255,255,.14);display:grid;grid-template-columns:auto 1fr;grid-template-areas:\"l v\" \"n n\";align-items:baseline;column-gap:10px;row-gap:2px;}.ds-band-safe span{grid-area:l;font-size:14px;font-weight:600;color:#bfe8cc;}.ds-band-safe b{grid-area:v;justify-self:end;font-size:20px;font-weight:700;}.ds-band-safe small{grid-area:n;font-size:13px;color:rgba(255,255,255,.7);}.ds-proof-band{font:inherit;color:inherit;background:none;border:0;padding:0;text-decoration:underline dotted #bfe8cc 1.5px;text-underline-offset:4px;border-radius:4px;cursor:pointer;}.ds-proof-band:active{background:rgba(255,255,255,.12);}.ds-proof-band:focus-visible{outline:2px solid #bfe8cc;outline-offset:2px;}"
    },
    {
      "name": "Module with Proof Line",
      "kind": "card",
      "refersTo": "module",
      "description": "Borderless white module; every computed number is a proof-line button.",
      "html": "<article class=\"ds-module\"><h2>Where October went</h2><p>Cafés took <button class=\"ds-proof\">€87</button> across 16 visits.</p></article>",
      "css": ".ds-module{font-family:\"Figtree Variable\",system-ui,sans-serif;width:358px;background:#fff;border-radius:20px;padding:16px;box-shadow:0 1px 2px rgba(16,36,27,.06);color:#10241b;font-size:16px;line-height:24px;}.ds-module h2{margin:0 0 8px;font-size:19px;line-height:1.3;font-weight:600;letter-spacing:-0.01em;}.ds-module p{margin:0;}.ds-proof{font:inherit;color:inherit;background:none;border:0;padding:0;text-decoration:underline dotted #007a3d 1.5px;text-underline-offset:4px;border-radius:4px;cursor:pointer;font-variant-numeric:tabular-nums lining-nums;}.ds-proof:hover,.ds-proof:active{background:#e6f4ea;}.ds-proof:focus-visible{outline:2px solid #007a3d;outline-offset:2px;}"
    },
    {
      "name": "Three Baskets",
      "kind": "custom",
      "refersTo": "module",
      "description": "Segmented basket bar and keyed rows.",
      "html": "<div class=\"ds-baskets\"><div class=\"ds-bbar\"><span style=\"flex-grow:52;background:#0e3b2a\"></span><span style=\"flex-grow:14;background:#f0a63a\"></span><span style=\"flex-grow:34;background:#36b26b\"></span></div><div class=\"ds-brow\"><i style=\"background:#0e3b2a\"></i><span>Fixed bills<small>rent, phone, insurance</small></span><b>€612</b></div><div class=\"ds-brow\"><i style=\"background:#f0a63a\"></i><span>Surprises<small>dentist, repairs</small></span><b>€160</b></div><div class=\"ds-brow\"><i style=\"background:#36b26b\"></i><span>Slips away<small>cafés, Wolt, taxis</small></span><b>€398</b></div></div>",
      "css": ".ds-baskets{font-family:\"Figtree Variable\",system-ui,sans-serif;width:326px;color:#10241b;font-variant-numeric:tabular-nums lining-nums;}.ds-bbar{display:flex;gap:3px;height:14px;border-radius:999px;overflow:hidden;margin:6px 0 10px;}.ds-bbar span{flex-basis:0;min-width:4px;}.ds-brow{display:grid;grid-template-columns:12px 1fr auto;align-items:center;gap:12px;min-height:56px;border-top:1px solid #e8eee9;}.ds-brow:first-of-type{border-top:0;}.ds-brow i{width:12px;height:12px;border-radius:4px;}.ds-brow span{display:flex;flex-direction:column;line-height:1.3;}.ds-brow small{font-size:13px;color:#4a5d53;}.ds-brow b{font-size:17px;font-weight:700;text-decoration:underline dotted #007a3d 1.5px;text-underline-offset:4px;}"
    },
    {
      "name": "Landing Bar CTA and Switch",
      "kind": "button",
      "refersTo": "lp-bar-cta",
      "description": "Chalk pill CTA and the dot-field view switch on spruce.",
      "html": "<div class=\"ds-lp-on\"><a class=\"ds-lp-cta\" href=\"#\">Open Kori</a><div class=\"ds-lp-switch\" role=\"group\"><button aria-pressed=\"false\">One app</button><button aria-pressed=\"true\">Their money</button></div></div>",
      "css": ".ds-lp-on{font-family:\"Schibsted Kori\",\"Figtree Variable\",system-ui,sans-serif;display:flex;gap:24px;align-items:center;padding:24px;background:#0c3a2b;}.ds-lp-cta{color:#0c3a2b;background:#f4f7f2;padding:9px 18px;border-radius:999px;font-size:15px;font-weight:600;text-decoration:none;transition:background .2s;}.ds-lp-cta:hover{background:#fff;}.ds-lp-cta:focus-visible,.ds-lp-switch button:focus-visible{outline:2px solid #e4ef9a;outline-offset:3px;}.ds-lp-switch{display:inline-flex;padding:4px;border-radius:999px;background:rgba(244,247,242,.08);}.ds-lp-switch button{font:inherit;font-size:14px;font-weight:600;padding:7px 14px;border:0;border-radius:999px;background:none;color:#c5d6cb;cursor:pointer;transition:background .25s,color .25s;}.ds-lp-switch button:hover{color:#f4f7f2;}.ds-lp-switch button[aria-pressed=true]{background:#f4f7f2;color:#0c3a2b;}"
    },
    {
      "name": "Dot Field",
      "kind": "custom",
      "refersTo": "lp-field",
      "description": "Landing data mark: customers as dots coloured by money style, demo people ringed.",
      "html": "<figure class=\"ds-field\"><p>The same 393, by how money moves</p><svg viewBox=\"0 0 300 120\" width=\"300\" height=\"120\"><g font-size=\"12\" font-weight=\"650\" fill=\"#f4f7f2\"><text x=\"0\" y=\"24\">Steady</text><text x=\"0\" y=\"54\">Saver</text><text x=\"0\" y=\"84\">Tight months</text><text x=\"0\" y=\"114\">Pay moves on</text></g><g><circle cx=\"110\" cy=\"20\" r=\"3.6\" fill=\"#8fd3a8\"/><circle cx=\"118\" cy=\"20\" r=\"3.6\" fill=\"#8fd3a8\"/><circle cx=\"126\" cy=\"20\" r=\"3.6\" fill=\"#8fd3a8\"/><circle cx=\"150\" cy=\"50\" r=\"3.6\" fill=\"#e4ef9a\"/><circle cx=\"158\" cy=\"50\" r=\"3.6\" fill=\"#e4ef9a\"/><circle cx=\"190\" cy=\"80\" r=\"3.6\" fill=\"#f4b04a\"/><circle cx=\"198\" cy=\"80\" r=\"3.6\" fill=\"#f4b04a\"/><circle cx=\"170\" cy=\"110\" r=\"3.6\" fill=\"#ff8f70\"/><circle cx=\"178\" cy=\"110\" r=\"3.6\" fill=\"#ff8f70\"/><circle cx=\"240\" cy=\"20\" r=\"3.6\" fill=\"#6f8f7f\"/></g><circle cx=\"118\" cy=\"20\" r=\"9\" fill=\"none\" stroke=\"#f4f7f2\" stroke-width=\"1.6\"/></svg><figcaption>Each dot is one customer. Age across, money style down.</figcaption></figure>",
      "css": ".ds-field{font-family:\"Schibsted Kori\",\"Figtree Variable\",system-ui,sans-serif;margin:0;width:340px;padding:24px 24px 20px;border-radius:28px;background:#0f4533;color:#f4f7f2;font-variant-numeric:tabular-nums lining-nums;}.ds-field p{margin:0 0 8px;font-size:17px;font-weight:600;}.ds-field figcaption{margin-top:10px;font-size:13.5px;line-height:1.5;color:#9cb5a6;}.ds-field circle{transition:transform 1.1s cubic-bezier(.16,1,.3,1),fill .8s ease;}"
    }
  ],
  "narrative": {
    "northStar": "Spruce Ledger",
    "overview": "Kori is Nordic data journalism wearing a bank's calm. One deep spruce green owns the top of every surface: the full-bleed first viewport of the landing and the brand band at the top of every phone screen. Under the spruce sits a pale green-grey daylight ground with white, near-flat cards. Type is a large, tight grotesk for statements and figures, and a round, plain sans for the app's working text. The only ornament is data itself: dots, bars, a calendar grid, a dotted proof underline.\n\nThe landing (route `/`) argues like a newspaper data feature: a 72-82px sentence-case headline in chalk on spruce, a 393-dot field that re-sorts from one grey \"statement\" block into four money-style rows, then live phones and plain rule lists separated by 2px ink rules. The app (S-mobiili shell, Figtree) is an Operate surface: one spruce band carrying greeting, balance and safe-to-spend, then modules on the ground, an Ask Kori field and a five-tab bar. The shell is pixel-identical for every customer; only modules, order, tone, text size and density change.\n\nDensity is set per person through `--text-scale` presets (Roomy 1.0625, Regular 1, Compact 0.9375, Large 1.1875) that also move row height (60/56/48/64) and module gap and padding (20/16/12/20). Energy goes only into the interactive moments (a guess you can lose, a future you can drag, a month you can fix) and the landing's single dot re-sort.",
    "keyCharacteristics": [
      "Spruce owns the first viewport (landing) and the top band (app); everything below is daylight.",
      "Chalk-white type on spruce, deep green ink on light; one action green.",
      "Data marks are the only ornament; no gradients, glass, glow or illustration.",
      "Large grotesk numerals and sentence-case statements, tabular figures for all money.",
      "Pill controls, borderless near-flat cards, one surface per tool.",
      "Every computed number carries a dotted proof underline that opens its receipt."
    ],
    "rules": [
      {
        "name": "The Spruce Top Rule",
        "body": "Spruce owns the top of the surface: the landing's first viewport, the app's status bar, header and balance band. Below that line, surfaces are daylight. Spruce never becomes a card colour mid-page in the app.",
        "section": "colors"
      },
      {
        "name": "The Green Means Act Rule",
        "body": "Action Green is for actions, current selection and state. Money leaving is Ink, never red; red is only below zero and errors. No per-customer colours.",
        "section": "colors"
      },
      {
        "name": "The Data Hue Rule",
        "body": "Basket and money-style hues mark data (bars, dots, keys) and nothing else: never a button, a heading or a card ground.",
        "section": "colors"
      },
      {
        "name": "The White Label Rule",
        "body": "White text sits on Action Green (5.45:1), never on Mark Green (3.19:1).",
        "section": "colors"
      },
      {
        "name": "The Sentence Leads Rule",
        "body": "Inside an app module the largest type is a sentence, except the live guess number. Figures earn display size only in the spruce band (balance) and on the landing (headline numerals, scale grid); there they are the world's native device.",
        "section": "typography"
      },
      {
        "name": "The Tabular Money Rule",
        "body": "Every amount and date uses `tabular-nums lining-nums`. The landing turns them off for prose and back on for numerals and the dot field.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "No uppercase tracked labels, no labels above headings. Headings use `text-wrap: balance`.",
        "section": "typography"
      },
      {
        "name": "The One Surface Rule",
        "body": "A tool inside a card or sheet is not a second card: no border, shadow, ground or padding on nested modules.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do start every app home with the spruce band and every landing with a full-bleed spruce first viewport.",
      "Do keep the shell (band, header, Ask bar, tab bar, type, colours, radii, proof line) identical for every customer; vary only modules, order, tone and the `--text-scale` preset.",
      "Do put a dotted proof underline on every computed number and make its receipt total equal it.",
      "Do use data marks (dots, bars, calendar cells, rules) as the only ornament, coloured only from the basket and money-style hues.",
      "Do set money and dates in tabular lining figures.",
      "Do use Action Green (#007a3d family) under any white label."
    ],
    "donts": [
      "Don't use gradients, glass, glow or coloured side stripes on cards.",
      "Don't add uppercase tracked labels, eyebrows or kickers above headings.",
      "Don't use red for ordinary spending or give a customer their own colour theme.",
      "Don't use a serif or hairline-editorial type, or any app font other than Figtree.",
      "Don't nest a card inside a card or sheet; the inner tool loses its surface.",
      "Don't use sparkle, wand, robot or brain icons, emoji, or unicode glyphs as icons.",
      "Don't let sheets or overlays escape the device frame on desktop."
    ]
  }
}